# Copy to .env on the server: cp .env.example .env

POSTGRES_PASSWORD=change-me-strong-postgres-password
JWT_SECRET=change-me-long-random-jwt-secret
WAHA_API_KEY=change-me-waha-api-key

# Public base URL (no trailing slash) — nginx on port 80
WEBHOOK_PUBLIC_URL=http://77.42.32.8:3040

# AI: mock | ollama | openai
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Optional Docker Hub (docker compose push)
# DOCKERHUB_USER=yourdockerhub
# IMAGE_TAG=latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
