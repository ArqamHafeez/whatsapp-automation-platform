# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_platform?schema=public"

# JWT
JWT_SECRET="your-secret-key"

# WAHA (WhatsApp HTTP API) — NOWEB engine recommended for channels
WAHA_API_URL="http://127.0.0.1:8081"
# WAHA_BASE_URL="http://127.0.0.1:8081"
WAHA_API_KEY="your-waha-api-key"

# Public URL of this Nest API — registers WAHA webhooks on session create
# WEBHOOK_PUBLIC_URL="https://your-backend.example.com"

# AI / LLM (relevance, clean, route agents)
AI_PROVIDER="openai"
# AI_PROVIDER="mock"
# AI_PROVIDER="ollama"
OPENAI_API_KEY="sk-your-openai-key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_VISION_MODEL="gpt-4o-mini"
# Ollama (local, free) — when AI_PROVIDER=ollama
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"
# OLLAMA_VISION_MODEL="llava"
# If Nest runs in WSL but Ollama runs on Windows, use the Windows host IP instead of 127.0.0.1
# OLLAMA_BASE_URL="http://172.x.x.x:11434"
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
# AI_MOCK_RELEVANT=false
# AI_MOCK_ROUTE_FIRST_ONLY=true
# AI_MOCK_NEEDS_REVIEW=true

# Relevance escalation (low confidence → review when reviewMode=on_escalation)
RELEVANCE_ESCALATION_CONFIDENCE=0.75

# Image watermark removal (image_edit pipeline agent)
# IMAGE_EDIT_PROVIDER=local
# IMAGE_EDIT_PROVIDER=cloud
IMAGE_EDIT_CORNER_FALLBACK=true
IMAGE_EDIT_MAX_BYTES=5242880
IMAGE_EDIT_BLUR_SIGMA=18
# Cloud inpainting (optional — requires OPENAI_API_KEY)
# IMAGE_EDIT_CLOUD_MODEL=dall-e-2

# Delivery rate limiting
DELIVERY_MAX_PER_MINUTE=30
DELIVERY_JITTER_MS=500

# Webhook reconciliation fallback (poll WAHA for missed messages)
RECONCILIATION_POLL_ENABLED=true
RECONCILIATION_POLL_INTERVAL_MS=300000
RECONCILIATION_MESSAGE_LIMIT=15
